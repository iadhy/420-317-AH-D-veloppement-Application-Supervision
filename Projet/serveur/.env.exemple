PORT=3000
MONGO_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/supervision

# Secret de signature des jetons : une longue chaine aleatoire, differente
# pour chaque personne. Pour en generer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-moi

# Origine autorisee a appeler l'API depuis un navigateur (facultatif).
# Laisser vide : meme origine seulement.
# CORS_ORIGIN=http://localhost:5500

# Mots de passe des comptes crees par npm run seed:users
SEED_ADMIN_PASSWORD=remplacez-moi
SEED_OPERATOR_PASSWORD=remplacez-moi

# Courtier MQTT (EMQX) : adresse et identifiants de VOTRE courtier.
# Exemple d'adresse : mqtts://xxxx.emqxsl.com:8883
MQTT_URL=remplacez-moi
MQTT_USERNAME=remplacez-moi
MQTT_PASSWORD=remplacez-moi

# Capteur simule de la seance 2 (pour essayer le tableau de bord sans carte).
# Laisser a false avec une vraie carte.
SIMULATE_SENSOR=false
